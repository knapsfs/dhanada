<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#021a59" />
      <stop offset="50%" stop-color="#032e92" />
      <stop offset="100%" stop-color="#011440" />
    </linearGradient>
    <linearGradient id="gold" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#c10000" />
      <stop offset="50%" stop-color="#e63946" />
      <stop offset="100%" stop-color="#c10000" />
    </linearGradient>
    <linearGradient id="cardBg" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.12" />
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0.04" />
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="1200" height="630" fill="url(#bg)" />

  <!-- Geometric Accent Circles / Glows -->
  <circle cx="1100" cy="100" r="300" fill="#0665d0" opacity="0.25" filter="blur(60px)" />
  <circle cx="100" cy="550" r="250" fill="#c10000" opacity="0.20" filter="blur(50px)" />

  <!-- Top Accent Bar -->
  <rect x="0" y="0" width="1200" height="8" fill="url(#gold)" />

  <!-- Content Container Card -->
  <rect x="70" y="60" width="1060" height="510" rx="24" fill="url(#cardBg)" stroke="#ffffff" stroke-opacity="0.15" stroke-width="1.5" />

  <!-- Pill Badge: Foundation & Legacy -->
  <g transform="translate(110, 110)">
    <rect width="320" height="38" rx="19" fill="#ffffff" fill-opacity="0.15" stroke="#ffffff" stroke-opacity="0.3" />
    <text x="160" y="24" font-family="'Montserrat', -apple-system, sans-serif" font-size="13" font-weight="700" fill="#ffffff" text-anchor="middle" letter-spacing="2">ESTABLISHED 1996 • NEW DELHI</text>
  </g>

  <!-- Brand Title -->
  <text x="110" y="220" font-family="'Montserrat', -apple-system, sans-serif" font-size="64" font-weight="900" fill="#ffffff" letter-spacing="-1">
    KNAPS <tspan fill="#f87171">PRIVATE LIMITED</tspan>
  </text>

  <!-- Subheadline -->
  <text x="110" y="280" font-family="'Montserrat', -apple-system, sans-serif" font-size="30" font-weight="600" fill="#93c5fd">
    Wealth Creation, Mutual Funds &amp; Investment Solutions
  </text>

  <text x="110" y="325" font-family="'Montserrat', -apple-system, sans-serif" font-size="19" font-weight="400" fill="#e2e8f0">
    Three decades of disciplined wealth advisory, portfolio management &amp; family trust in India.
  </text>

  <!-- Product Pills Container -->
  <g transform="translate(110, 385)">
    <!-- Pill 1 -->
    <rect x="0" y="0" width="160" height="44" rx="12" fill="#ffffff" fill-opacity="0.12" stroke="#ffffff" stroke-opacity="0.25" />
    <text x="80" y="27" font-family="'Montserrat', sans-serif" font-size="15" font-weight="700" fill="#ffffff" text-anchor="middle">Mutual Funds</text>

    <!-- Pill 2 -->
    <rect x="175" y="0" width="130" height="44" rx="12" fill="#ffffff" fill-opacity="0.12" stroke="#ffffff" stroke-opacity="0.25" />
    <text x="240" y="27" font-family="'Montserrat', sans-serif" font-size="15" font-weight="700" fill="#ffffff" text-anchor="middle">SIF / AIF</text>

    <!-- Pill 3 -->
    <rect x="320" y="0" width="150" height="44" rx="12" fill="#ffffff" fill-opacity="0.12" stroke="#ffffff" stroke-opacity="0.25" />
    <text x="395" y="27" font-family="'Montserrat', sans-serif" font-size="15" font-weight="700" fill="#ffffff" text-anchor="middle">NPS Pension</text>

    <!-- Pill 4 -->
    <rect x="485" y="0" width="180" height="44" rx="12" fill="#ffffff" fill-opacity="0.12" stroke="#ffffff" stroke-opacity="0.25" />
    <text x="575" y="27" font-family="'Montserrat', sans-serif" font-size="15" font-weight="700" fill="#ffffff" text-anchor="middle">Fixed Income (FD)</text>

    <!-- Pill 5 -->
    <rect x="680" y="0" width="155" height="44" rx="12" fill="#ffffff" fill-opacity="0.12" stroke="#ffffff" stroke-opacity="0.25" />
    <text x="757" y="27" font-family="'Montserrat', sans-serif" font-size="15" font-weight="700" fill="#ffffff" text-anchor="middle">Life Insurance</text>
  </g>

  <!-- Footer Info Line -->
  <g transform="translate(110, 510)">
    <circle cx="6" cy="-6" r="4" fill="#22c55e" />
    <text x="22" y="-2" font-family="'Montserrat', sans-serif" font-size="14" font-weight="600" fill="#cbd5e1">
      AMFI Registered Mutual Fund Distributor • DLF Galleria Mayur Vihar, New Delhi
    </text>
    <text x="960" y="-2" font-family="'Montserrat', sans-serif" font-size="16" font-weight="800" fill="#ffffff" text-anchor="end">
      https://knaps.in
    </text>
  </g>
</svg>

